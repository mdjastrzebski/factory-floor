{
  "name": "factory-floor",
  "version": "0.1.0",
  "description": "Run a linear sequence of AI coding-agent steps against a shared working directory, defined in a YAML flow file.",
  "bin": {
    "factory-floor": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node src/cli.ts",
    "factory-floor": "node dist/cli.js",
    "test": "node --test test/*.test.ts",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:write": "oxfmt ."
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.24.0"
}
